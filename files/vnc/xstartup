#!/bin/bash
# 每次桌面启动都建立独立总线；所有辅助程序也在新总线内运行。
vnc_session() {
  [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ] || return 1
xrdb ${HOME}/.Xresources
export PULSE_SERVER=127.0.0.1
# 电池链路(原生 power-manager-plugin 用): fakebat同步 → 系统D-Bus → upowerd
# proot 无 systemd/udev 需手动拉; 幂等, :2 那边先起过也不会重复。
[ -x /root/.local/bin/power-stack.sh ] && /root/.local/bin/power-stack.sh start >/tmp/power-stack-vnc.log 2>&1
# ── 应用运行时环境(2026-09-25 补) ────────────────────────────────
# 原先只有 /usr/local/bin/startx11:90 source 了 apps.sh, 走 VNC(:1) 起的桌面
# 拿不到 LANG/LANGUAGE、QT_QPA_PLATFORM、XDG_RUNTIME_DIR、VLC_PLUGIN_PATH 等,
# 导致 :1 上的 Qt/libvlc 应用行为与 :2(Termux:X11) 不一致。
# 与 startx11 同顺序: apps.sh 必须在 im.sh 和起桌面【之前】。
[ -r /root/.config/desktop-env/apps.sh ] && . /root/.config/desktop-env/apps.sh
# 中文输入法(ibus+libpinyin)
if [ -r /root/.config/desktop-env/im.sh ]; then . /root/.config/desktop-env/im.sh; im_start; fi

# 光标同步 + 看守(2026-09-25 建, 2026-09-26 补看守; 同 startx11)
#   cursor-sync.sh : 把 xfconf 里的光标主题/大小推给 xrdb + 根窗(会话启动时一次)
#   cursor-watch.sh: 常驻监听 xfconf 的 /Gtk/CursorTheme*, 用户在 GUI 里一改就自动再同步一次
#                    (没有它的话, 会话启动后再改大小就没人同步了 —— 这是"改了没反应"的一半原因)
# 必须【后台延时】: 下面是 exec, 之后的代码不会执行; 且要等 xfsettingsd 起来才读得到 xfconf。
[ -x /root/.config/desktop-env/cursor-sync.sh ] && \
  ( sleep 8; /root/.config/desktop-env/cursor-sync.sh "${DISPLAY:-:1}"
    [ -x /root/.config/desktop-env/cursor-watch.sh ] && \
      /root/.config/desktop-env/cursor-watch.sh start "${DISPLAY:-:1}" ) >/dev/null 2>&1 &

# 壁纸/面板双向同步 :1<->:2 (2026-09-28; 根因见账本: tumbler-cache-plugin.so 符号链缺失 + 两会话脑裂)。
#   xfsync-watch.sh 自身等两条会话总线就绪、flock 单例、崩溃/总线变更自愈; 从 :1/:2 各调一次都安全。
#   关闭: 环境变量 XFSYNC=0。
# 先自愈 tumbler cache 软链(防系统更新/清理再把它删掉 → 「背景→目录」又空白); 只补软链, 幂等。
[ -x /root/.config/desktop-env/ensure-tumbler-link.sh ] && /root/.config/desktop-env/ensure-tumbler-link.sh >/dev/null 2>&1
[ -x /root/.config/desktop-env/xfsync-watch.sh ] && \
  ( sleep 12; /root/.config/desktop-env/xfsync-watch.sh start ) >/dev/null 2>&1 &

exec startxfce4
}
export -f vnc_session
unset SESSION_MANAGER ICEAUTHORITY DBUS_SESSION_BUS_ADDRESS DBUS_SESSION_BUS_PID DBUS_SESSION_BUS_WINDOWID
command -v dbus-launch >/dev/null 2>&1 || { echo "缺少 dbus-launch，未启动 VNC 桌面" >&2; exit 1; }
exec dbus-launch --exit-with-session bash -c vnc_session
