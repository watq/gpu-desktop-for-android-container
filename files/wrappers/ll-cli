HELP = """ll-cli (linyaps-lite %s) —— proot 环境下的无容器玲珑包管理器

用法:
  ll-cli install   <应用ID>[/版本]      下载并安装(自动带 base/runtime, 自动生成桌面入口)
  ll-cli uninstall <应用ID>             卸载并清掉桌面入口
  ll-cli run       <应用ID> [-- 命令]   运行(不用 bwrap)
  ll-cli list      [--json] [--all]     已安装列表
  ll-cli ps        [--json]             运行中的玲珑进程
  ll-cli kill      <应用ID>             结束进程
  ll-cli search    <关键词> [--json]    搜索远端仓库
  ll-cli info      <应用ID> [--json]    包信息
  ll-cli repo show [--json]             仓库配置
  ll-cli upgrade   [应用ID...]          升级
  ll-cli prune     [--json]             清理无用 base/runtime
  ll-cli --version                      版本

注意: 这是给 proot(无用户命名空间) 环境写的替身实现, 没有容器隔离。
""" % VERSION


def main():
    argv = sys.argv[1:]
    log("argv=%r cwd=%s" % (argv, os.getcwd()))
    as_json = "--json" in argv
    argv = [a for a in argv if a != "--json"]

    if not argv or argv[0] in ("-h", "--help", "help"):
        print(HELP)
        return 0
    cmd = argv[0]
    rest = argv[1:]

    if cmd in ("--version", "-V", "version"):
        if as_json:
            print(json.dumps({"code": 0, "message": "", "version": VERSION},
                             ensure_ascii=False))
        else:
            print("ll-cli version: %s" % VERSION)
            print("ll-cli %s" % VERSION)
        return 0
    if cmd == "--print-architecture":
        print(ARCH)
        return 0

    try:
        if cmd == "install":
            return cmd_install(rest)
        if cmd in ("uninstall", "remove"):
            return cmd_uninstall(rest)
        if cmd == "run":
            return cmd_run(rest)
        if cmd == "list":
            return cmd_list(rest, as_json)
        if cmd == "ps":
            return cmd_ps(rest, as_json)
        if cmd == "repo":
            return cmd_repo(rest, as_json)
        if cmd == "search":
            return cmd_search(rest, as_json)
        if cmd == "info":
            return cmd_info(rest, as_json)
        if cmd == "kill":
            return cmd_kill(rest)
        if cmd == "prune":
            return cmd_prune(as_json)
        if cmd == "upgrade":
            return cmd_upgrade(rest)
        if cmd == "enter":
            err("proot 环境下没有容器, 不支持 ll-cli enter")
            return 1
    except KeyboardInterrupt:
        return 130

    err("未知子命令: %s" % cmd)
    print(HELP)
    return 1


if __name__ == "__main__":
    sys.exit(main())
