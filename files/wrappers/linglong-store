#!/bin/bash
# ══════════════════════════════════════════════════════════════════════
# linglong-store 启动 shim【本体】(2026-09-24 起; 2026-09-28 迁 .local + 加字体放大)
#   落点: /root/.local/lib/linglong-shim/  (用户级, 在 $HOME 内; dpkg 管不到, 升级冲不掉)
#   /root/.local/bin/linglong-store 是指向本文件的软链(PATH 最前);
#   /usr/local/bin/linglong-store 也是指向本文件的软链(兜底)。
#   ★2026-09-28: 原来是 /usr/local/bin 里的真文件(系统级), 现改成 .local/lib 本体 + 软链,
#     与 spark-store 同构, 才算真正的"用户级"。同目录已有 no_impeller.so / dbus-login1-stub.so。
#   配合 ~/.local/share/applications/ 下两个同名 .desktop override(Exec 指 .local/bin),
#   可一次覆盖全部入口: 主菜单图标、og:// 协议唤起、终端直接跑。
#
# ★ 它【不是 Electron】, 是 Flutter Linux GTK 应用(lib/libflutter_linux_gtk.so + libapp.so
#   + data/flutter_assets/)。不要给它加 --no-sandbox —— Flutter 不认这个参数。
#   (注意: data/icudtl.dat 会让"按 icudtl.dat 判 Electron"的探测误判, Flutter 也用这个文件。)
#
# ══════ 本机(proot Ubuntu on Android / Adreno 830)三道坎, 缺一不可 ══════
#
# 坎 1: 应用自己回落到软件渲染 → SIGABRT(134)
#   主程序 linglong_store 读 /proc/cpuinfo 做 CPU 白名单(只认 GenuineIntel / AuthenticAMD),
#   ARM 必然判定 cpuFallback → g_setenv("FLUTTER_LINUX_RENDERER","software")
#   → 引擎用 Skia CPU 画布, 但文字是 Impeller 录制的 DlText
#   → [FATAL] Check failed: blob. "Impeller DlText cannot be drawn to a Skia canvas." → abort。
#   修: 抢先把 FLUTTER_LINUX_RENDERER 定死成 opengl(decisionSource 变成 environment, 优先级最高)。
#   ⚠ 引擎只认 opengl / software 两个值, 写 vulkan 会被警告"Unknown renderer type"后改回 opengl。
#   ⚠ 反向对照: LIBGL_ALWAYS_SOFTWARE=1 会让 EGL context 创建失败 → 同样 abort, 不能走这条路。
#
# 坎 2: zink(默认 GL 驱动)在 Xtigervnc(:1) 上起不来 → exit 1
#   日志: MESA: error: CreateSwapchainKHR failed with VK_ERROR_INITIALIZATION_FAILED
#         MESA: error: zink: could not create swapchain
#         Gdk-WARNING: X Window System error 'GLXBadCurrentWindow'
#   修: 强制走 kgsl 原生驱动(实测 :1/:2 都能出 Adreno (TM) 830v1, GLES 3.2)。
#
# 坎 3: Impeller 的 OpenGLESSDF 后端在本机画不出字形图集 → 窗口能开, 但【所有文字和图标全是空白】
#   (界面只剩色块和按钮轮廓, 用户看着就像"打不开")。字体没问题(fc-list 314 个, CJK 有文泉驿)。
#   修: LD_PRELOAD 一个垫片拦 fl_dart_project_new(), 拿到 project 后调
#       fl_dart_project_set_enable_impeller(project, FALSE) → 引擎改用 Skia GL 路径。
#       日志里 "Using the Impeller rendering backend (OpenGLESSDF)." 那行消失即为生效。
#       源码: /usr/local/lib/linglong-store/no_impeller.c
#   (Impeller 全关后不存在"Impeller DlText 画进 Skia 画布"的错配, 坎 1 的 abort 也不会复现。)
#
# ⚠ 期望值: 开窗、文字渲染、浏览 UI 都正常。
# ★2026-09-24 更新(本段旧说法"ll-cli 未装 + bwrap 跑不起来 → 装不了玲珑应用"已被推翻, 见 已验证事实 E-AG):
#   现有自建轻量实现 /usr/local/bin/ll-cli(不依赖官方 linglong-bin, 也不需要 bwrap),
#   已实测【下载 + 安装 + 签出 + 生成用户级 desktop】成功(样本 org.deepin.movie)。
#   → 首屏的"环境检测"若仍提示, 点"跳过此步"照旧可进主界面; 装应用现在走 ll-cli 是可行的。
#   ※ 签出务必带 --force-copy: proot 下 ostree --user-mode 做不了硬链接, 会退化成 .l2s.* 符号链接,
#     Qt 的 QDirListing 枚举这种目录返回 0 条 → 误报"找不到 Qt 平台插件 xcb"(E-AG)。
#   ※ 仍未解决: 深度影院 `ll-cli run org.deepin.movie` 退出码 139 段错误(E-AN, 在查)。
#   ※ 官方 linglong-bin + bwrap 那条路仍然不通(bwrap 读不到 /proc/sys/kernel/overflowuid),
#     这是环境硬限制; 上面的轻量实现正是为绕开它而写的。
# ══════════════════════════════════════════════════════════════════════
set -u

BIN=/opt/linglong-store/linglong_store
[ -x "$BIN" ] || { echo "[✘] 找不到 $BIN (玲珑商店没装好?)"; exit 1; }

export DISPLAY="${DISPLAY:-:1}"

# 坎 1
export FLUTTER_LINUX_RENDERER=opengl

# 坎 2 (设 LINGLONG_STORE_KEEP_DRIVER=1 可跳过, 方便排查)
if [ -z "${LINGLONG_STORE_KEEP_DRIVER:-}" ]; then
  export MESA_LOADER_DRIVER_OVERRIDE=kgsl
  export LIBGL_ALWAYS_SOFTWARE=0
fi

# 坎 3 (设 LINGLONG_STORE_KEEP_IMPELLER=1 可跳过, 方便排查)
#   本体优先用 .local 里的(用户级), 找不到再回退 /usr/local/lib(旧位置, 兜底)。
SHIM_SO=/root/.local/lib/linglong-shim/no_impeller.so
[ -f "$SHIM_SO" ] || SHIM_SO=/usr/local/lib/linglong-store/no_impeller.so
if [ -z "${LINGLONG_STORE_KEEP_IMPELLER:-}" ] && [ -f "$SHIM_SO" ]; then
  export LD_PRELOAD="${SHIM_SO}${LD_PRELOAD:+:$LD_PRELOAD}"
fi

# ── 字体放大(2026-09-28, 用户级防更新覆盖) ──
#   玲珑=Flutter。Flutter Linux 嵌入层回退到 FlGnomeSettings 时会读 GSettings 键
#     org.gnome.desktop.interface text-scaling-factor 并作为 textScaleFactor 应用到全部文字
#     (已用 strings 在 libflutter_linux_gtk.so 里证实它链了这个 schema)。
#   用【per-app dconf profile】只给本应用把该键覆盖成放大值, 不污染全局(其它应用照常 1.0);
#   本体全在 .local/lib/linglong-shim/dconf/(用户级, 会被 backup 收)。
#   调节: LINGLONG_FONT_SCALE=1.5 linglong-store ; 要原始大小设 LINGLONG_FONT_SCALE=1.0
LL_SHIM=/root/.local/lib/linglong-shim/dconf
LL_SCALE="${LINGLONG_FONT_SCALE:-1.3}"
if command -v dconf >/dev/null 2>&1; then
  _cur=$(sed -n 's/^text-scaling-factor=//p' "$LL_SHIM/db.d/00-bigfont" 2>/dev/null)
  if [ ! -f "$LL_SHIM/bigfont.db" ] || [ "$LL_SCALE" != "$_cur" ]; then
    mkdir -p "$LL_SHIM/db.d" 2>/dev/null
    printf '[org/gnome/desktop/interface]\ntext-scaling-factor=%s\n' "$LL_SCALE" > "$LL_SHIM/db.d/00-bigfont" 2>/dev/null
    printf 'user-db:user\nfile-db:%s/bigfont.db\n' "$LL_SHIM" > "$LL_SHIM/profile" 2>/dev/null
    dconf compile "$LL_SHIM/bigfont.db" "$LL_SHIM/db.d" 2>/dev/null || true
  fi
  [ -f "$LL_SHIM/bigfont.db" ] && [ "$LL_SCALE" != 1.0 ] && [ "$LL_SCALE" != 1 ] && export DCONF_PROFILE="$LL_SHIM/profile"
fi

# 本机会话 portal 缺 Settings 接口，Flutter 却不自行回退，导致上述 profile 无效。
# 只让本进程中 Flutter 创建的 Settings 代理回退；其他 DBus/GTK 代理照常透传。
# 2026-10-03 独立显示验证：同页文字放大，普通 DBus 与非 Flutter Settings 代理可用。
# 逃生：LINGLONG_FONT_SETTINGS_FALLBACK=0 保留旧行为；不修改会话总线地址。
LL_FONT_SETTINGS=/root/.local/lib/linglong-shim/font_settings.so
if [ "${LINGLONG_FONT_SETTINGS_FALLBACK:-1}" != 0 ] && [ -r "$LL_FONT_SETTINGS" ]; then
  export LINGLONG_FONT_SETTINGS_FALLBACK=1
  export LD_PRELOAD="${LL_FONT_SETTINGS}${LD_PRELOAD:+:$LD_PRELOAD}"
fi

exec "$BIN" "$@"
